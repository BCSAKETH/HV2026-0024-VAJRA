# ---- Supabase ----
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never ship to web/mobile
SUPABASE_ANON_KEY=your-anon-key                   # used only for the real (non-bypass) OTP send/verify calls

# ---- App-issued session JWT (FastAPI mints these after OTP verification) ----
APP_JWT_SECRET=change-me-to-a-long-random-string
APP_JWT_ALGORITHM=HS256
APP_JWT_EXPIRE_MINUTES=1440

# ---- Hackathon demo bypass ----
# If verify-otp receives this exact token, real OTP verification is skipped.
# Leave this set for the demo; unset it (or randomize it) for a real deployment.
DEMO_OTP_BYPASS_CODE=000000

# ---- Fast2SMS — the ACTIVE consumer-SMS provider, never staff OTP ----
# See app/core/fast2sms.py. Uses route=q (Quick SMS), the only Fast2SMS
# route that accepts arbitrary custom text without DLT template
# registration — but note it's gated behind a real >=100 INR wallet top-up
# regardless of trial status (confirmed live; not documented anywhere).
# Until that's cleared, sends fail closed exactly like an unconfigured key.
FAST2SMS_API_KEY=your-fast2sms-api-key

# ---- Twilio (WhatsApp Sandbox) — DORMANT, kept working but unused ----
# Was the original consumer-notification channel; swapped to Fast2SMS above
# because Twilio's trial tier requires an approved Content Template to send
# anything (freeform Body is rejected, and the Content API needed to create
# one is itself blocked on trial accounts). Code is correct and ready if
# this account is ever upgraded — see app/core/twilio_whatsapp.py.
# Account SID is always required (it's the account the request authenticates
# against, not a credential). Then EITHER the Auth Token OR an API Key
# SID/Secret pair authenticates the request — if both are set, the API Key
# pair wins. API Keys (console.twilio.com -> Account -> API keys & tokens)
# are the better choice: scoped, revocable without rotating the whole
# account's Auth Token.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Mistral (Vision OCR) ----
# Switched from Groq — Groq has zero working vision-capable chat models as of
# this build (every Llama vision variant decommissioned, confirmed live).
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_VISION_MODEL=ministral-8b-latest   # "-latest" alias avoids repeating the staleness problem

# ---- Nominatim (OSM geocoding) ----
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=locus-logistics-app (contact: you@example.com)

# ---- OSRM (road-network routing/directions) ----
# Public demo instance, no signup or key needed. Rate-limited and not meant
# for production traffic — every caller falls back to a straight-line
# estimate if it's unreachable. Swap for a self-hosted OSRM or a paid
# provider's URL later without touching any calling code.
OSRM_BASE_URL=https://router.project-osrm.org

# ---- Misc ----
ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PUBLIC_WEB_BASE_URL=http://localhost:3000   # used to build the /track/{id} link sent over WhatsApp
